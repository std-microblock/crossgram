# ThreadLocalObject normally posts destruction and returns immediately. That
# leaves Manager, NetworkManager, and MediaManager retaining EncryptionKey
# after the caller has been told teardown completed. resetSync() moves the
# holder to its owning thread and waits unless it is already on that thread.
# Manager uses it to synchronously destroy media then network before releasing
# its own encryption copy; Instance::stopAndWait exposes that barrier for every
# pinned Instance implementation.
--- a/tgcalls/ThreadLocalObject.h
+++ b/tgcalls/ThreadLocalObject.h
@@ -27 +27,9 @@
-		_thread->PostTask([valueHolder = std::move(_valueHolder)](){
+		resetAsync();
+	}
+
+	void resetSync() {
+		auto valueHolder = std::move(_valueHolder);
+		if (!valueHolder) {
+			return;
+		}
+		auto reset = [valueHolder = std::move(valueHolder)]() mutable {
@@ -29 +37,6 @@
-		});
+		};
+		if (_thread->IsCurrent()) {
+			reset();
+		} else {
+			_thread->BlockingCall(std::move(reset));
+		}
@@ -46,0 +60,9 @@
+	void resetAsync() {
+		if (!_valueHolder) {
+			return;
+		}
+		_thread->PostTask([valueHolder = std::move(_valueHolder)]() {
+			valueHolder->_value.reset();
+		});
+	}
+

{
  "name": "@mtproto-relay/mtproto-statistics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./client/index.ts"
  },
  "cordis": {
    "public": [
      "dist"
    ],
    "service": {
      "implements": [
        "mtprotoStatistics"
      ],
      "required": [
        "mtproto",
        "webui"
      ]
    },
    "webui": {
      "framework": "react",
      "entry": "client/index.ts",
      "pages": [
        {
          "path": "/mtproto-statistics",
          "title": "MTProto statistics",
          "icon": "statistics",
          "group": "Observe"
        }
      ]
    }
  },
  "peerDependencies": {
    "@mtproto-relay/mtproto": "workspace:*",
    "cordis": "^4.0.0-rc.5",
    "cordis-webui-react": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/react-is": "^19",
    "happy-dom": "^20.11.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "react-is": "^19.3.1",
    "recharts": "^3.10.1",
    "schemastery": "^3.18.0"
  }
}

{
  "name": "@mtproto-relay/mtproto-debug",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./client/index.ts"
  },
  "cordis": {
    "public": [
      "dist"
    ],
    "service": {
      "required": [
        "mtproto",
        "server",
        "webui"
      ]
    },
    "webui": {
      "framework": "solid",
      "entry": "client/index.ts",
      "pages": [
        {
          "path": "/mtproto-debug",
          "title": "MTProto capture",
          "icon": "⇄",
          "group": "Observe"
        }
      ]
    }
  },
  "peerDependencies": {
    "@cordisjs/plugin-server": "^1.6.2",
    "@mtproto-relay/mtproto": "workspace:*",
    "cordis": "^4.0.0-rc.5",
    "cordis-webui-solidjs": "workspace:*"
  },
  "devDependencies": {
    "happy-dom": "^20.11.2",
    "solid-js": "^1.9.9",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "long": "^5.3.2",
    "schemastery": "^3.18.0"
  }
}

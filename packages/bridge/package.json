{
  "name": "@mtproto-relay/bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./client/index.ts"
  },
  "cordis": {
    "public": [
      "dist"
    ],
    "service": {
      "required": [
        "mtproto",
        "updateStore",
        "webui"
      ]
    },
    "webui": {
      "framework": "solid",
      "entry": "client/index.ts",
      "pages": [
        {
          "path": "/platform-accounts",
          "title": "Platform accounts",
          "icon": "account",
          "group": "Accounts"
        },
        {
          "path": "/sticker-packs",
          "title": "Sticker collections",
          "icon": "smile",
          "group": "Accounts"
        },
        {
          "path": "/bots",
          "title": "Your bots",
          "icon": "bot",
          "group": "Accounts"
        }
      ]
    }
  },
  "peerDependencies": {
    "@cordisjs/plugin-database": "^4.0.0",
    "@cordisjs/plugin-server": "^1.6.0",
    "cordis": "^4.0.0-rc.5",
    "cordis-webui-solidjs": "workspace:*"
  },
  "dependencies": {
    "@mtcute/core": "^0.32.1",
    "@mtcute/tl-runtime": "^0.32.0",
    "@mtproto-relay/mtproto": "workspace:*",
    "@mtproto-relay/update-store": "workspace:*",
    "@mtproto-relay/update-store-memory": "workspace:*",
    "jsqr": "^1.4.0",
    "linkify-it": "^6.1.0",
    "long": "^5.3.2",
    "schemastery": "^3.18.0",
    "tlds": "^1.261.0"
  },
  "devDependencies": {
    "@fuman/io": "^0.0.21",
    "@fuman/utils": "^0.0.21",
    "@mtcute/node": "^0.32.1",
    "happy-dom": "^20.11.2",
    "solid-js": "^1.9.9"
  }
}

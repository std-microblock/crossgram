{
  "name": "cordis-webui-react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./client/sdk.tsx",
    "./schema": "./client/schema.tsx",
    "./build": "./build.ts",
    "./server": "./src/server-monitor.ts",
    "./components": "./client/components.tsx",
    "./utils": "./client/utils.ts",
    "./session": "./client/session.ts",
    "./icons": "./client/icons.tsx",
    "./styles/tokens.css": "./client/styles/tokens.css",
    "./styles/base.css": "./client/styles/base.css"
  },
  "cordis": {
    "service": {
      "implements": [
        "webui"
      ],
      "required": [
        "server"
      ]
    }
  },
  "dependencies": {
    "@cordisjs/fetch-file": "^1.0.3",
    "@cordisjs/muon": "^0.2.2",
    "@simplewebauthn/browser": "^13.1.0",
    "@tanstack/react-virtual": "^3.13.48",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "path-to-regexp": "^8.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "schemastery": "^3.18.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "happy-dom": "^20.11.2",
    "prettier": "3.6.2",
    "qrcode": "^1.5.4",
    "vite": "^7.3.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@cordisjs/plugin-server": "^1.7.0",
    "cordis": "4.0.0-rc.7"
  },
  "scripts": {
    "format": "prettier --write --no-semi --single-quote --trailing-comma all \"{src,client}/**/*.{ts,tsx,css}\" build.ts vite.config.ts"
  }
}

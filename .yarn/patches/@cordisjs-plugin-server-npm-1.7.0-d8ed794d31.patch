+function redactRouteParams(params) {
+  if (!params || typeof params !== "object") return params;
+  try {
+    return Object.fromEntries(Object.entries(params).map(([key, value]) => {
+      const decoded = decodeSafely(String(value));
+      return isSensitiveName(key) || looksLikeToken(decoded) ? [key, "<redacted>"] : [key, value];
+    }));
+  } catch {
+    return "<redacted>";
+  }
+}
+function redactRequestUrl(url) {
+  try {
+    const [path, query = ""] = url.split("?", 2);
+    let redactNext = false;
+    const redactedPath = path.split("/").map((segment) => {
+      const decoded = decodeSafely(segment);
+      const redact = redactNext || looksLikeToken(decoded) || isSensitiveName(decoded) || /^([^=]+)=/.test(decoded) && isSensitiveName(decoded.split("=", 1)[0]);
+      redactNext = isSensitiveName(decoded);
+      return redact ? "<redacted>" : segment;
+    }).join("/");
+    if (!query) return redactedPath;
+    const redactedQuery = query.split("&").map((part) => {
+      const [key, value = ""] = part.split("=", 2);
+      const decodedKey = decodeSafely(key);
+      const decodedValue = decodeSafely(value);
+      return isSensitiveName(decodedKey) || looksLikeToken(decodedValue) ? `${key}=<redacted>` : part;
+    }).join("&");
+    return `${redactedPath}?${redactedQuery}`;
+  } catch {
+    return "<redacted>";
+  }
+}
+function decodeSafely(value) {

+    } catch {
+      throw new Error("malformed URL encoding");
+    }
+    if (decoded === value) return decoded;
+    value = decoded;
+  }
+  try {
+    if (decodeURIComponent(value) !== value) throw new Error("URL encoding exceeds redaction depth");
+  } catch {
+    throw new Error("malformed URL encoding");
+  }
+  return value;
+}
+function isSensitiveName(value) {
+  return /token|secret|password|authorization|(?:api|access)[_-]?key|credential|session|cookie/i.test(value);
